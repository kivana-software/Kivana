{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kivana",
  "version": "0.4.11",
  "identifier": "com.personal.PersonalFinances",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kivana",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https: http: http://localhost:11434",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1RThFRUZCMzFENUZBQjQKUldTMCt0VXgrKzdveFk4SEMxYUpjUzlHQXU2WWovNWlNb0d3dExXblBrc3NpU1cvZk1VMzBEcnIK",
      "endpoints": [
        "https://github.com/kivana-software/Kivana/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
